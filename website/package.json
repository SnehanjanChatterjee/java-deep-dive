    "@phosphor-icons/react": "2.1.10",
    "astro": "5.18.2",
    "mermaid": "12.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
